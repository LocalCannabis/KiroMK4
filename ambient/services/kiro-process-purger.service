[Unit]
Description=Kiro Ambient — Content Purger Processing Worker
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=macklemoron
WorkingDirectory=/home/macklemoron/Projects/KiroMK4
Environment=PATH=/home/macklemoron/miniconda3/envs/kiro_asr/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/home/macklemoron/.kiro/ambient.env
ExecStart=/home/macklemoron/miniconda3/envs/kiro_asr/bin/python -m ambient.process.purger
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kiro-process-purger

[Install]
WantedBy=multi-user.target
