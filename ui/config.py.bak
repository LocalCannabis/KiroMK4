"""
KIRO UI — Configuration
Persona definitions, DB connection, and app settings.
All persona additions happen here — no code changes needed.
"""

import os

# ---------------------------------------------------------------------------
# Database — default points at local Kiro PostgreSQL instance.
# Override with env vars for portability to other machines.
# ---------------------------------------------------------------------------
DB_CONFIG = {
    "host": os.getenv("KIRO_DB_HOST", "localhost"),
    "port": int(os.getenv("KIRO_DB_PORT", 5432)),
    "database": os.getenv("KIRO_DB_NAME", "kiro"),
    "user": os.getenv("KIRO_DB_USER", "kiro"),
    "password": os.getenv("KIRO_DB_PASS", "kiro"),
}

DATABASE_URL = os.getenv(
    "KIRO_DATABASE_URL",
    "postgresql://{user}:{password}@{host}:{port}/{database}".format(**DB_CONFIG),
)

# ---------------------------------------------------------------------------
# App settings
# ---------------------------------------------------------------------------
APP_TITLE = "KIRO"
APP_WIDTH = 1280
APP_HEIGHT = 820
FLASK_PORT = int(os.getenv("KIRO_UI_PORT", 5199))
SECRET_KEY = os.getenv("KIRO_SECRET", "kiro-dev-key-change-me")

